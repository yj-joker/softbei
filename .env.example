# Copy this file to .env in the repository root. Never commit the real .env.

DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fix
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=86400

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

FILE_STORAGE_BACKEND=minio
FILE_PUBLIC_BASE_URL=/files
LOCAL_FILE_STORAGE_DIR=rag_files
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_DOCUMENT_BUCKET=weixiu-private-wendang
MINIO_PUBLIC_IMAGE_BUCKET=weixiu-public-tupian
MINIO_PUBLIC_BASE_URL=http://localhost:9000/weixiu-public-tupian
MINIO_SECURE=false

# Java -> FixAgent authentication. Must match FixAgent API_TOKEN.
API_TOKEN=REPLACE_WITH_RANDOM_API_TOKEN
# FixAgent -> Java authentication. Must be different from API_TOKEN.
INTERNAL_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_INTERNAL_TOKEN

JAVA_SERVICE_URL=http://localhost:8080
PYTHON_SERVICE_URL=http://localhost:8000
CLARIFICATION_MODE=enforce
RAG_VARIANT=production
GRAPH_QUALITY_HIGH_THRESHOLD=0.85
GRAPH_QUALITY_MEDIUM_THRESHOLD=0.70
IMAGE_SUMMARY_LLM_ENABLED=true
