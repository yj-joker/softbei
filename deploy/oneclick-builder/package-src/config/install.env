# 安装器输入配置模板（不包含任何真实密钥）。API_TOKEN和INTERNAL_TOKEN均留空时安装器会分别生成两枚不同令牌。
# REDIS_HOST必须指向可执行FT.SEARCH的Redis Stack/RediSearch实例；本包不再硬编码远程公网地址。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fix
MYSQL_USER=maintai
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=maintai
MYSQL_APP_PASSWORD=
MYSQL_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_PASSWORD=
RABBITMQ_USER=maintai
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://maintai:@127.0.0.1:5672/
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=maintaiadmin
MINIO_SECRET_KEY=
DASHSCOPE_API_KEY=
API_TOKEN=
INTERNAL_TOKEN=
